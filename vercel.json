{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "api/export-history.js", "use": "@vercel/node" },
    { "src": "api/trades.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/export-history", "dest": "api/export-history.js" },
    { "src": "/api/trades", "dest": "api/trades.js" },
    { "src": "/(.*)", "dest": "server.js" }
  ]
}
