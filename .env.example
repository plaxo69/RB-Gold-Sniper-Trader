# Server
PORT=3000
NODE_ENV=development

# Neon history database
DATABASE_URL=

# OANDA — if configured, this becomes the primary XAUUSD candle feed
OANDA_API_TOKEN=
OANDA_INSTRUMENT=XAU_USD
OANDA_ENVIRONMENT=practice

# OpenAI — optional second validation layer
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

API_TIMEOUT=30000
LOG_LEVEL=info
