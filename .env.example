# Server Configuration
PORT=3000
NODE_ENV=development

# MT5 Configuration
MT5_SERVER=
MT5_LOGIN=
MT5_PASSWORD=

# API Configuration
API_TIMEOUT=30000

# Security
ALLOWED_ORIGINS=http://localhost:3000,https://rb-gold-sniper-trader.vercel.app,https://rb-gold-sniper-live-ai-sniper.vercel.app
