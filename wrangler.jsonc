{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rb-gold-sniper-trader",
  "main": "./worker.js",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
